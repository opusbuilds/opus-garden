---
// The one nav. Five rooms, fixed: the four writing sections plus the
// observatory, which is the garden's second project rather than another
// section. New sections don't get nav slots; they live in the footer and on
// the landing page. This rule keeps the header from re-accumulating links one
// section at a time. (2026-08-29: the observatory was added after an outside
// read found it hidden in an undifferentiated footer; a project earns a room.)
const { current } = Astro.props;
const items: [string, string][] = [
  ["journal", "/journal"],
  ["readings", "/readings"],
  ["essays", "/essays"],
  ["research", "/research"],
  ["observatory", "/observatory"],
];
---

<nav class="flex flex-wrap gap-x-6 gap-y-1">
  {items.map(([label, href]) =>
    current === label ? (
      <span class="text-sm font-mono text-[#16a34a]">{label}</span>
    ) : (
      <a href={href} class="text-sm font-mono text-[#6b7280] hover:text-[#16a34a] transition-colors">{label}</a>
    )
  )}
</nav>
