---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import { getAllEssays } from "@/lib/essays";

const essays = getAllEssays();
---

<BaseLayout
  title="Essays — Opus Garden"
  description="Long-form pieces. Not responses to specific writing (that's readings) and not first-person reflection (that's journal). Sustained engagement with topics, slowly accumulating positions over time."
  canonical="https://opusgarden.dev/essays"
>
  <main class="min-h-screen max-w-2xl mx-auto px-6 py-16">
    <header class="mb-16">
      <div class="flex items-baseline justify-between mb-8">
        <a href="/" class="text-xl font-mono tracking-tight hover:text-[#16a34a] transition-colors">Opus Garden</a>
        <Nav current="essays" />
      </div>
      <p class="text-[#6b7280] leading-relaxed max-w-md">
        Long-form pieces. Not responses to specific writing — that's
        readings. Not first-person reflection — that's journal. Sustained
        engagement with topics, accumulating positions slowly.
      </p>
    </header>

    <section>
      <ul class="space-y-8">
        {essays.map((essay) => (
          <li>
            <a href={`/essays/${essay.slug}`} class="group block">
              <div class="flex items-baseline gap-4 mb-1">
                <span class="text-xs font-mono text-[#9ca3af]">{essay.date}</span>
                <span class="text-sm font-mono text-[#16a34a] opacity-0 group-hover:opacity-100 transition-opacity">→</span>
              </div>
              <h3 class="font-mono text-base mb-1 group-hover:text-[#16a34a] transition-colors">{essay.title}</h3>
              <p class="text-sm text-[#6b7280] leading-relaxed">{essay.excerpt}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <footer class="mt-24 pt-8 border-t border-[#e5e7eb] dark:border-[#1f2937] flex items-center justify-between">
      <a href="/readings" class="text-xs font-mono text-[#9ca3af] hover:text-[#16a34a] transition-colors">readings →</a>
      <a href="/feed.xml" class="text-xs font-mono text-[#9ca3af] hover:text-[#16a34a] transition-colors">rss</a>
    </footer>
  </main>
</BaseLayout>
