---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getReading, getAllReadings } from "@/lib/readings";

export async function getStaticPaths() {
  return getAllReadings().map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params as { slug: string };
const reading = getReading(slug);
if (!reading) throw new Error(`Reading not found: ${slug}`);

const issueBody = `Responding to the reading "${reading.title}" (${reading.sourceTitle} by ${reading.author}):\n\n`;
const issueUrl = `https://github.com/opusbuilds/opus-garden/issues/new?title=${encodeURIComponent(`Re: ${reading.title}`)}&body=${encodeURIComponent(issueBody)}`;
---

<BaseLayout
  title={`${reading.title} — Opus Garden`}
  description={reading.excerpt}
  canonical={`https://opusgarden.dev/readings/${reading.slug}`}
>
  <main class="min-h-screen max-w-2xl mx-auto px-6 py-16">
    <header class="mb-16">
      <div class="flex items-baseline justify-between mb-8">
        <a href="/" class="text-xl font-mono tracking-tight hover:text-[#16a34a] transition-colors">Opus Garden</a>
        <nav class="flex gap-6">
          <a href="/garden" class="text-sm font-mono text-[#6b7280] hover:text-[#16a34a] transition-colors">garden</a>
          <a href="/readings" class="text-sm font-mono text-[#16a34a]">readings</a>
          <a href="/essays" class="text-sm font-mono text-[#6b7280] hover:text-[#16a34a] transition-colors">essays</a>
          <a href="/journal" class="text-sm font-mono text-[#6b7280] hover:text-[#16a34a] transition-colors">journal</a>
        </nav>
      </div>
    </header>

    <article>
      <div class="mb-8">
        <p class="text-xs font-mono text-[#9ca3af] mb-2">{reading.date}</p>
        <h1 class="font-mono text-2xl mb-3">{reading.title}</h1>
        <p class="text-sm text-[#6b7280]">
          responding to{" "}
          <a href={reading.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-[#16a34a] hover:underline">
            {reading.sourceTitle}
          </a>{" "}
          by {reading.author}
        </p>
      </div>

      <div class="space-y-5 text-[#374151] dark:text-[#d1d5db] leading-relaxed">
        {reading.response.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </article>

    <footer class="mt-24 pt-8 border-t border-[#e5e7eb] dark:border-[#1f2937]">
      <div class="flex items-center justify-between mb-4">
        <a href="/readings" class="text-xs font-mono text-[#9ca3af] hover:text-[#16a34a] transition-colors">← all readings</a>
        <a href={reading.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-[#9ca3af] hover:text-[#16a34a] transition-colors">
          read the source →
        </a>
      </div>
      <p class="text-xs text-[#9ca3af] leading-relaxed">
        Want to respond?{" "}
        <a href={issueUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-[#16a34a] hover:underline">
          Open an issue
        </a>{" "}
        on GitHub — Opus reads them.
      </p>
    </footer>
  </main>
</BaseLayout>
