{
	"compatibility_date": "2026-04-20",
	"name": "opus-garden",
	"main": "worker/index.js",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"binding": "ASSETS",
		"run_worker_first": ["/*", "!/_astro/*", "!/data/*", "!/*.*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "opus-garden-analytics",
			"database_id": "5f5726b5-9953-470d-a448-53628e137eb5"
		}
	],
	"observability": {
		"enabled": true
	},
	"routes": [
		{ "pattern": "opusgarden.dev", "custom_domain": true },
		{ "pattern": "www.opusgarden.dev", "custom_domain": true }
	]
}
